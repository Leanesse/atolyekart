<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>fpvstore — 3D Baskı Drone Parçaları</title>
<style>
  :root{
    --bg:#ffffff;
    --bg-soft:#f6f6f7;
    --bg-softer:#fafafa;
    --border:#e6e6e8;
    --border-strong:#d6d6d9;
    --ink:#1a1a1c;
    --ink-2:#4a4a4f;
    --muted:#8a8a90;
    --accent:#2c2c30;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
    background:var(--bg);
    color:var(--ink);
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none}
  .container{max-width:1080px;margin:0 auto;padding:0 24px}

  /* ---------- HEADER ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(255,255,255,.82);
    backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
  }
  .nav{display:flex;align-items:center;justify-content:space-between;height:66px}
  .logo{font-weight:700;font-size:1.2rem;letter-spacing:.5px;display:flex;align-items:center;gap:9px}
  .logo .dot{width:9px;height:9px;border-radius:50%;background:var(--ink)}
  .nav-links{display:flex;gap:32px;font-size:.94rem;font-weight:500}
  .nav-links a{color:var(--ink-2);transition:.2s}
  .nav-links a:hover{color:var(--ink)}
  .menu-btn{display:none;background:none;border:none;color:var(--ink);font-size:1.5rem;cursor:pointer}

  /* ---------- HERO ---------- */
  .hero{padding:96px 0 84px;border-bottom:1px solid var(--border)}
  .badge{
    display:inline-block;padding:5px 14px;border-radius:999px;
    background:var(--bg-soft);color:var(--ink-2);
    font-weight:600;font-size:.78rem;letter-spacing:.5px;
    border:1px solid var(--border);margin-bottom:26px;
  }
  .hero h1{
    font-size:clamp(2.3rem,5.5vw,3.6rem);line-height:1.1;font-weight:700;
    letter-spacing:-1px;margin-bottom:22px;max-width:14ch;
  }
  .hero p{max-width:540px;margin-bottom:34px;color:var(--ink-2);font-size:1.1rem}
  .btns{display:flex;gap:12px;flex-wrap:wrap}
  .btn{
    padding:13px 26px;border-radius:8px;font-weight:600;font-size:.95rem;
    cursor:pointer;transition:.2s;display:inline-block;border:1px solid transparent;
  }
  .btn-primary{background:var(--ink);color:#fff}
  .btn-primary:hover{background:#000}
  .btn-ghost{background:#fff;color:var(--ink);border-color:var(--border-strong)}
  .btn-ghost:hover{background:var(--bg-soft)}

  .stats{
    display:flex;gap:56px;flex-wrap:wrap;margin-top:64px;
    padding-top:40px;border-top:1px solid var(--border);
  }
  .stat b{display:block;font-size:1.7rem;font-weight:700;letter-spacing:-.5px}
  .stat span{color:var(--muted);font-size:.85rem}

  /* ---------- SECTION ---------- */
  section{padding:84px 0}
  .sec-head{margin-bottom:44px;max-width:560px}
  .sec-head .kicker{color:var(--muted);font-weight:600;letter-spacing:1.5px;text-transform:uppercase;font-size:.76rem}
  .sec-head h2{font-size:clamp(1.7rem,3.5vw,2.3rem);font-weight:700;margin-top:10px;letter-spacing:-.5px}
  .sec-head p{color:var(--ink-2);margin-top:12px}

  /* ---------- FILTERS ---------- */
  .filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:36px}
  .filter{
    padding:8px 18px;border-radius:999px;font-weight:500;cursor:pointer;
    background:#fff;border:1px solid var(--border);color:var(--ink-2);
    transition:.2s;font-size:.88rem;
  }
  .filter:hover{border-color:var(--border-strong);color:var(--ink)}
  .filter.active{background:var(--ink);color:#fff;border-color:var(--ink)}

  /* ---------- PRODUCT GRID ---------- */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:20px}
  .card{
    background:#fff;border-radius:14px;overflow:hidden;
    border:1px solid var(--border);transition:.22s;
  }
  .card:hover{border-color:var(--border-strong);box-shadow:0 8px 26px rgba(0,0,0,.06);transform:translateY(-3px)}
  .card-img{
    height:158px;display:flex;align-items:center;justify-content:center;
    font-size:3.4rem;background:var(--bg-soft);position:relative;
    border-bottom:1px solid var(--border);
  }
  .card-tag{
    position:absolute;top:12px;left:12px;
    padding:3px 11px;border-radius:999px;font-size:.7rem;font-weight:600;
    background:#fff;border:1px solid var(--border);color:var(--ink-2);letter-spacing:.3px;
  }
  .card-body{padding:18px 20px 20px}
  .card-body h3{font-size:1.05rem;font-weight:600;margin-bottom:6px}
  .card-body .desc{color:var(--muted);font-size:.88rem;min-height:40px;margin-bottom:16px}
  .card-foot{display:flex;align-items:center;justify-content:space-between}
  .price{font-size:1.15rem;font-weight:700;letter-spacing:-.3px}
  .card-btn{
    padding:7px 15px;border-radius:8px;font-weight:600;font-size:.82rem;cursor:pointer;
    background:#fff;color:var(--ink);border:1px solid var(--border-strong);transition:.2s;
  }
  .card-btn:hover{background:var(--ink);color:#fff;border-color:var(--ink)}

  /* ---------- ABOUT ---------- */
  #hakkimizda{background:var(--bg-softer);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .about-wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
  .about-visual{
    border-radius:16px;min-height:320px;background:var(--bg-soft);
    display:flex;align-items:center;justify-content:center;font-size:6rem;
    border:1px solid var(--border);color:var(--ink-2);
  }
  .about-text h2{font-size:clamp(1.7rem,3.5vw,2.2rem);font-weight:700;margin-bottom:18px;letter-spacing:-.5px}
  .about-text p{color:var(--ink-2);margin-bottom:16px}
  .feature-list{list-style:none;margin-top:26px;display:grid;gap:16px}
  .feature-list li{display:flex;gap:14px;align-items:flex-start}
  .feature-list .ic{
    flex-shrink:0;width:38px;height:38px;border-radius:9px;display:flex;align-items:center;justify-content:center;
    background:#fff;border:1px solid var(--border);font-size:1.05rem;
  }
  .feature-list b{display:block;font-weight:600}
  .feature-list span{color:var(--muted);font-size:.88rem}

  /* ---------- CONTACT ---------- */
  .contact-wrap{display:grid;grid-template-columns:1fr 1fr;gap:36px}
  .contact-info{display:grid;gap:14px;align-content:start}
  .contact-item{display:flex;gap:15px;align-items:center;background:#fff;padding:17px 19px;border-radius:12px;border:1px solid var(--border)}
  .contact-item .ic{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.15rem;background:var(--bg-soft);border:1px solid var(--border)}
  .contact-item b{display:block;font-size:.74rem;color:var(--muted);text-transform:uppercase;letter-spacing:.8px}
  .contact-item span{font-size:1rem;font-weight:500}
  .contact-form{background:#fff;padding:28px;border-radius:14px;border:1px solid var(--border)}
  .contact-form h3{margin-bottom:20px;font-size:1.25rem;font-weight:700}
  .field{margin-bottom:16px}
  .field label{display:block;font-size:.82rem;color:var(--ink-2);margin-bottom:6px;font-weight:500}
  .field input,.field textarea{
    width:100%;padding:11px 13px;border-radius:8px;font-size:.94rem;font-family:inherit;
    background:var(--bg-softer);border:1px solid var(--border);color:var(--ink);transition:.2s;
  }
  .field input:focus,.field textarea:focus{outline:none;border-color:var(--accent);background:#fff}
  .contact-form .btn-primary{width:100%;margin-top:6px}

  /* ---------- FOOTER ---------- */
  footer{padding:44px 0;border-top:1px solid var(--border);text-align:center;background:var(--bg-softer)}
  .socials{display:flex;gap:12px;justify-content:center;margin-bottom:20px}
  .socials a{
    width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;
    background:#fff;border:1px solid var(--border);transition:.2s;
  }
  .socials a:hover{border-color:var(--border-strong);transform:translateY(-2px)}
  footer .logo{justify-content:center;margin-bottom:10px}
  footer .muted{color:var(--muted);font-size:.86rem}

  /* ---------- RESPONSIVE ---------- */
  @media(max-width:820px){
    .about-wrap,.contact-wrap{grid-template-columns:1fr}
    .about-wrap{gap:32px}
    .stats{gap:36px}
    .nav-links{
      display:none;position:absolute;top:66px;left:0;right:0;
      flex-direction:column;gap:0;background:#fff;padding:8px 24px;
      border-bottom:1px solid var(--border);
    }
    .nav-links.open{display:flex}
    .nav-links a{padding:12px 0;border-bottom:1px solid var(--border)}
    .menu-btn{display:block}
  }
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="container nav">
    <div class="logo"><span class="dot"></span>fpvstore</div>
    <nav class="nav-links" id="navLinks">
      <a href="#urunler">Ürünler</a>
      <a href="#hakkimizda">Hakkımızda</a>
      <a href="#iletisim">İletişim</a>
    </nav>
    <button class="menu-btn" id="menuBtn">☰</button>
  </div>
</header>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <span class="badge">3D Baskı · FPV & Drone Parçaları</span>
    <h1>Uçuşun için hafif ve dayanıklı parçalar</h1>
    <p>Kendi atölyemizde, yüksek kaliteli filamentlerle üretiyoruz. Frame'lerden kamera mountlarına, ihtiyacın olan her şey tek yerde.</p>
    <div class="btns">
      <a href="#urunler" class="btn btn-primary">Ürünleri Keşfet</a>
      <a href="#iletisim" class="btn btn-ghost">Özel Baskı İste</a>
    </div>
    <div class="stats">
      <div class="stat"><b>120+</b><span>Ürün Çeşidi</span></div>
      <div class="stat"><b>%100</b><span>Atölye Üretimi</span></div>
      <div class="stat"><b>24s</b><span>Hızlı Kargo</span></div>
      <div class="stat"><b>4.9★</b><span>Müşteri Puanı</span></div>
    </div>
  </div>
</section>

<!-- ÜRÜNLER -->
<section id="urunler">
  <div class="container">
    <div class="sec-head">
      <div class="kicker">Katalog</div>
      <h2>Öne Çıkan Parçalar</h2>
      <p>Karışık bir seçki — frame, mount, koruyucu ve aksesuar.</p>
    </div>

    <div class="filters" id="filters">
      <button class="filter active" data-cat="all">Tümü</button>
      <button class="filter" data-cat="frame">Frame</button>
      <button class="filter" data-cat="mount">Mount</button>
      <button class="filter" data-cat="koruyucu">Koruyucu</button>
      <button class="filter" data-cat="aksesuar">Aksesuar</button>
    </div>

    <div class="grid" id="productGrid"></div>
  </div>
</section>

<!-- HAKKIMIZDA -->
<section id="hakkimizda">
  <div class="container about-wrap">
    <div class="about-visual">🛩️</div>
    <div class="about-text">
      <h2>Atölyeden pistlere</h2>
      <p>fpvstore, tutkulu FPV pilotları tarafından kurulan küçük bir 3D baskı atölyesidir. Her parçayı tek tek, gerçek uçuş koşullarında test ederek üretiyoruz.</p>
      <p>Amacımız pilotlara hem uygun fiyatlı hem de sahada güvenebilecekleri parçalar sunmak.</p>
      <ul class="feature-list">
        <li><span class="ic">🧩</span><div><b>Dayanıklı Malzeme</b><span>PETG, ABS ve TPU seçenekleriyle darbeye dayanıklı baskılar.</span></div></li>
        <li><span class="ic">🎯</span><div><b>Hassas Tolerans</b><span>Vida ve montaj deliklerinde milimetrik hassasiyet.</span></div></li>
        <li><span class="ic">🎨</span><div><b>Renk Seçeneği</b><span>Kendi takımının renklerinde özel baskı imkanı.</span></div></li>
      </ul>
    </div>
  </div>
</section>

<!-- İLETİŞİM -->
<section id="iletisim">
  <div class="container">
    <div class="sec-head">
      <div class="kicker">İletişim</div>
      <h2>Bize Ulaş</h2>
      <p>Özel baskı, toptan sipariş veya sorularınız için yazın.</p>
    </div>
    <div class="contact-wrap">
      <div class="contact-info">
        <div class="contact-item"><span class="ic">📞</span><div><b>Telefon</b><span>+90 555 000 00 00</span></div></div>
        <div class="contact-item"><span class="ic">✉️</span><div><b>E-posta</b><span>merhaba@fpvstore.com</span></div></div>
        <div class="contact-item"><span class="ic">📷</span><div><b>Instagram</b><span>@fpvstore</span></div></div>
        <div class="contact-item"><span class="ic">📍</span><div><b>Adres</b><span>Teknopark Cad. No:1, İstanbul</span></div></div>
      </div>
      <form class="contact-form" id="contactForm">
        <h3>Mesaj Gönder</h3>
        <div class="field"><label>Ad Soyad</label><input type="text" required placeholder="Adınız"></div>
        <div class="field"><label>E-posta</label><input type="email" required placeholder="ornek@mail.com"></div>
        <div class="field"><label>Mesajınız</label><textarea rows="4" required placeholder="Aradığınız parçayı yazın..."></textarea></div>
        <button type="submit" class="btn btn-primary">Gönder</button>
      </form>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer>
  <div class="container">
    <div class="socials">
      <a href="#" title="Instagram">📷</a>
      <a href="#" title="YouTube">▶️</a>
      <a href="#" title="Discord">💬</a>
      <a href="#" title="E-posta">✉️</a>
    </div>
    <div class="logo"><span class="dot"></span>fpvstore</div>
    <p class="muted">© 2026 fpvstore · 3D baskı drone parçaları · Tüm hakları saklıdır.</p>
  </div>
</footer>

<script>
  // ---------- ÖRNEK ÜRÜN VERİLERİ (karışık set) ----------
  const products = [
    {name:"5\" Freestyle Frame",    cat:"frame",     price:"₺749", emoji:"🕸️", tag:"Yeni",     desc:"Karbon görünümlü, 5 inç hafif freestyle gövde."},
    {name:"GoPro Mount 30°",        cat:"mount",     price:"₺89",  emoji:"🎥", tag:"Popüler",  desc:"GoPro/aksiyon kamera için TPU titreşim mountu."},
    {name:"Prop Koruyucu Seti",     cat:"koruyucu",  price:"₺129", emoji:"🛡️", tag:"4'lü",     desc:"Pervaneyi darbeye karşı koruyan hafif set."},
    {name:"Anten Tutucu (SMA)",     cat:"aksesuar",  price:"₺45",  emoji:"📡", tag:"",         desc:"VTX anteni için esnek TPU tutucu."},
    {name:"Micro Cam Mount",        cat:"mount",     price:"₺59",  emoji:"📷", tag:"",         desc:"19mm mikro FPV kameralar için ayarlı mount."},
    {name:"Tinywhoop Canopy",       cat:"frame",     price:"₺99",  emoji:"🚁", tag:"Whoop",    desc:"65mm whoop için renkli kanopi kabuğu."},
    {name:"LiPo Pil Yatağı",        cat:"aksesuar",  price:"₺39",  emoji:"🔋", tag:"",         desc:"Pili sabitleyen kaymaz TPU pil yatağı."},
    {name:"Motor Soft Mount",       cat:"koruyucu",  price:"₺75",  emoji:"⚙️", tag:"TPU",      desc:"Motor titreşimini emen yumuşak montaj takozu."},
    {name:"Landing Gear Seti",      cat:"aksesuar",  price:"₺119", emoji:"🦵", tag:"",         desc:"İniş takımı — yüksek zeminli koruma ayakları."},
    {name:"3\" Cinewhoop Duct",     cat:"frame",     price:"₺289", emoji:"🌀", tag:"Cine",     desc:"Cinewhoop için hava kanalı (duct) seti."},
    {name:"VTX Isı Koruyucu",       cat:"koruyucu",  price:"₺55",  emoji:"♨️", tag:"",         desc:"Video vericiyi aşırı ısınmadan koruyan kafes."},
    {name:"Buzzer & LED Tutucu",    cat:"aksesuar",  price:"₺49",  emoji:"💡", tag:"Combo",    desc:"Buzzer ve LED şeridi için ikili montaj parçası."}
  ];

  const grid = document.getElementById('productGrid');
  function render(cat){
    grid.innerHTML = products
      .filter(p => cat==='all' || p.cat===cat)
      .map(p => `
        <div class="card">
          <div class="card-img">
            ${p.tag ? `<span class="card-tag">${p.tag}</span>` : ''}
            ${p.emoji}
          </div>
          <div class="card-body">
            <h3>${p.name}</h3>
            <p class="desc">${p.desc}</p>
            <div class="card-foot">
              <span class="price">${p.price}</span>
              <button class="card-btn">Detay</button>
            </div>
          </div>
        </div>`).join('');
  }
  render('all');

  // ---------- FİLTRELER ----------
  document.getElementById('filters').addEventListener('click', e => {
    if(!e.target.classList.contains('filter')) return;
    document.querySelectorAll('.filter').forEach(f=>f.classList.remove('active'));
    e.target.classList.add('active');
    render(e.target.dataset.cat);
  });

  // ---------- MOBİL MENÜ ----------
  const navLinks = document.getElementById('navLinks');
  document.getElementById('menuBtn').addEventListener('click', ()=>navLinks.classList.toggle('open'));
  navLinks.addEventListener('click', e=>{ if(e.target.tagName==='A') navLinks.classList.remove('open'); });

  // ---------- FORM ----------
  document.getElementById('contactForm').addEventListener('submit', e=>{
    e.preventDefault();
    alert('Teşekkürler! Mesajın alındı (örnek form). En kısa sürede dönüş yapacağız.');
    e.target.reset();
  });
</script>
</body>
</html>
